<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key>            <string>computer-control-mcp</string>
  <key>CFBundleIdentifier</key>            <string>@CC_BUNDLE_ID@</string>
   <key>CFBundleName</key>                  <string>computer-control-mcp</string>
   <key>CFBundleDisplayName</key>           <string>computer-control-mcp</string>
  <key>CFBundlePackageType</key>           <string>APPL</string>
  <key>CFBundleShortVersionString</key>    <string>@PROJECT_VERSION@</string>
  <key>CFBundleVersion</key>               <string>@PROJECT_VERSION@</string>
  <key>LSMinimumSystemVersion</key>        <string>12.3</string>

  <!-- No Dock icon and no menu bar: this is a CLI in a bundle, not an app the
       user interacts with directly. -->
  <key>LSUIElement</key>                   <true/>

  <!-- Shown verbatim in the permission dialogs. Vague strings here are a
       common App Review rejection and, more to the point, are what the user
       reads when deciding whether to trust this. -->
  <key>NSAccessibilityUsageDescription</key>
   <string>computer-control-mcp needs Accessibility to read the on-screen element tree and to move the pointer and type on your behalf.</string>
  <key>NSAppleEventsUsageDescription</key>
   <string>computer-control-mcp sends Apple Events to launch and activate applications you ask it to control.</string>
</dict>
</plist>
