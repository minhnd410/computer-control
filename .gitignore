# ---------------------------------------------------------------------------
# Credentials and machine-specific state
# ---------------------------------------------------------------------------
# This is a public repository and this tool holds the keys to a desktop, so
# anything that could carry a secret or a bearer token is excluded by default
# rather than case by case.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa*
id_ed25519*
credentials.json
client_secret*.json
service-account*.json
.netrc
.npmrc
.pypirc
secrets.*
*.secret
*_token
*.token
auth.json
config.local.*
settings.local.*

# Captures can contain anything that was on the operator's screen: password
# managers, private messages, customer data. Never commit them.
screenshots/
captures/
*.png
*.jpg
*.jpeg
*.webp
!docs/**/*.png
!assets/**/*.png

# Local run artefacts
*.log
.cc-session/
